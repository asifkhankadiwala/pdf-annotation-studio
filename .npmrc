# Supply-chain hardening (Shai-Hulud / SHA1-Hulud class attacks)
# See SECURITY.md for rationale and developer setup.

# Pin exact versions in package.json (avoid silent semver drift)
save-exact=true

# Fail installs when Node/npm versions do not match package.json engines
engine-strict=true

# Surface vulnerabilities during install
audit=true
audit-level=moderate

# Reduce noise
fund=false

# Prefer lockfile integrity; use `npm ci` in CI
package-lock=true

# add minimum release of 5 days
minimum-release-days=5


# Optional: enable on developer machines for safer installs (may require
# `npm rebuild esbuild` afterward for Vite). Uncomment locally if desired:
ignore-scripts=true
